    {
      "cell_type": "markdown",
      "source": [
        "# **Mapping Outcomes**"
      ],
      "metadata": {
        "id": "UWenbnP8i2AO"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "Map = geemap.Map()\n",
        "\n",
        "#Regional Unit: Java\n",
        "\n",
        "#Strata Map IDs (Classes 1-7):\n",
        "  #IDN201610S110E ; IDN201610S105E\n",
        "  #               ; IDN201710S105E\n",
        "  #IDN201810S110E ; IDN201810S105E\n",
        "  #IDN201910S110E ; IDN201910S105E\n",
        "  #IDN202010S110E ; IDN202010S105E\n",
        "  #IDN202110S110E ; IDN202110S105E\n",
        "\n",
        "#Land Change Map IDs (Classes 1-13):\n",
        "  #IDN2016201710S110E ; IDN2016201710S105E\n",
        "  #IDN2017201910S110E ; IDN2017201910S105E\n",
        "  #IDN2019202110S110E ; IDN2019202110S105E\n",
        "\n",
        "\n",
        "#Select East and West maps of interest.\n",
        "data_1 = ee.Image(\n",
        "  'projects/ee-martingarciafry/assets/GlobalGroundCoverChange_v1/IndoMalayanEcoZone/Indonesia/Java/IDN202010S110E').select(['b1'])\n",
        "\n",
        "data_2 = ee.Image(\n",
        "  'projects/ee-martingarciafry/assets/GlobalGroundCoverChange_v1/IndoMalayanEcoZone/Indonesia/Java/IDN202010S105E').select(['b1'])\n",
        "\n",
        "#Apply gcc palette for the 13 distinct land cover classes.\n",
        "gccPalette = [\n",
        "  '#a99200', # 1. Dense Short Vegetation\n",
        "  '#0ec149', # 2. Open Tree Forest\n",
        "  '#04620a', # 3. Dense Tree Forest\n",
        "  '#78b0ff', # 4. Wetlands\n",
        "  '#d1dada', # 5. Urban\n",
        "  '#000367', # 6. Water\n",
        "  '#cc5902', # 7. Cropland\n",
        "  '#dd0505', # 8. senescence (strata maps) / Built Loss (change maps)\n",
        "  '#8e0808', # 9. cultiation (strata maps) / Built Gain (change maps)\n",
        "  '#fff203', # 10. Cropland Loss (change maps)\n",
        "  '#e4ce05', # 11. Cropland Gain (change maps)\n",
        "  '#01f2ff', # 12. Crop>Built (change maps)\n",
        "  '#06d6d6', # 13. Built>Crop (change maps)\n",
        "]\n",
        "\n",
        "Map.setCenter(110.5, -7.4, 7)\n",
        "vis_params = {'min': 1,\n",
        "              'max': 13,\n",
        "              'palette': gccPalette}\n",
        "\n",
        "Map.addLayer(data_1, vis_params, 'Java East')\n",
        "Map.addLayer(data_2, vis_params, 'Java West')\n",
        "\n",
        "Map\n"
      ],
